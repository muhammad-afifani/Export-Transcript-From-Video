# Salin file ini jadi .env lalu isi dengan API key milikmu sendiri. Jangan commit file .env.

# Untuk transkripsi audio (OpenAI Whisper API) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Untuk generate Minutes of Meeting (Claude API) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Untuk speaker diarization lokal (Hugging Face token, gratis) - https://huggingface.co/settings/tokens
# Wajib accept license di halaman berikut dengan akun HF yang sama sebelum token bisa dipakai:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Opsional, override default model
# WHISPER_MODEL=whisper-1
# ANTHROPIC_MODEL=claude-sonnet-5
